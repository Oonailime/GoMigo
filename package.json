{
  "name": "gomigo",
  "private": true,
  "overrides": {
    "ajv": "^8.18.0",
    "@prisma/config@6.19.2": {
      "effect": "3.20.1"
    },
    "effect": "3.20.1",
    "file-type": "^21.3.2"
  },
  "workspaces": [
    "Frontend",
    "Backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace Frontend",
    "dev:backend": "npm run start:dev --workspace Backend",
    "dev": "concurrently -n front,back -c blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build:frontend": "npm run build --workspace Frontend",
    "build:backend": "npm run build --workspace Backend",
    "postinstall": "node scripts/sync-prisma-effect.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "effect": "3.20.1"
  }
}
